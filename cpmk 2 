import java.util.Scanner;

public class Tugas1 {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        int harta;
        int nisab;
        int percobaan = 0;

        do {
            System.out.print("Total harta: Rp");
            harta = scanner.nextInt();

            System.out.print("nilai nisab: Rp");
            nisab = scanner.nextInt();

            percobaan++;

            if (harta < nisab) {
                System.out.println("harta belum mencapai nisab");
                System.out.println("kalau masih ada lagi tulis dibawah ya");
            } else if (harta >= nisab) {
                System.out.println("wajib bayar zakat sebanyak Rp" + harta * (0.025));
                System.out.println("kalau masih ada lagi tulis dibawah ya");
            }
        } while (harta > nisab);

        System.out.println("jangan pelit untuk zakat yaa");
        scanner.close();
    }
}


