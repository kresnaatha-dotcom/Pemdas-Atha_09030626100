import java.util.Scanner;

public class Tugas2 {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int motor = 2000;
        int mobil = 5000;
        int tariftambahanmotor = 1000;
        int tariftambahanmobil = 2000;
        int totaljam;

        do {
            System.out.print("berapa jam: ");
            totaljam = scanner.nextInt();

            if (totaljam > 0) {
                System.out.println("Total tarif motor: Rp" + (motor + (tariftambahanmotor * totaljam)));
                System.out.println("Total tarif mobil: Rp" + (mobil + (tariftambahanmobil * totaljam)));
                System.out.println("kalau masih ada lagi tulis dibawah ya");
            }
        } while (totaljam != 0);

        System.out.println("kalau masih ada lagi tulis dibawah ya");
        scanner.close();
    }
}

