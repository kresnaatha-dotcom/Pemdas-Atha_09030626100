import java.util.Scanner;
import java.util.Random;

public class Tugas3 {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        Random random = new Random();

        int tebakan;
        int percobaan = 0;
        int maxpercobaan = 7;

        int ar = random.nextInt(1, 101);

        System.out.println("Permainan tebak angka 1-100, ayo mulai");

        do {
            System.out.print("ayo tebak: ");
            tebakan = scanner.nextInt();
            percobaan++;

            if (tebakan < ar) {
                System.out.println("terlalu kecil");
            } else if (tebakan > ar) {
                System.out.println("terlalu besar");
            } else {
                System.out.println("nah, baru betul");
                System.out.println("jumlah percobaan: " + percobaan);
            }

            if (percobaan > maxpercobaan && tebakan != ar) {
                System.out.println("kesempatan habis, angka rahasianya adalah " + ar + "wkwkwwk");
                break;
            }
        } while (tebakan != ar && percobaan < maxpercobaan);

        if (tebakan == ar) {
            System.out.println("selamat, kamu menang");
            scanner.close();
        }
    }
}