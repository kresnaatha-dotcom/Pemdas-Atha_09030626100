public class BeasiswaTahfid {

    public static void main(String[] args) {
        Scanner beasiswa = new Scanner(System.in);

        System.out.println("Masukkan nilai ipk: ");
        double ipk = beasiswa.nextDouble();

        System.out.println("Masukkan penghasilan orang tua: ");
        double penghasilan = beasiswa.nextDouble();

        System.out.println("Masukkan tanggungan: ");
        int tanggungan = beasiswa.nextInt();

        System.out.println("Apakah pernah menerima beasiswa (true/false): ");
        boolean Beasiswa = beasiswa.nextBoolean();

        System.out.println("Apakah aktif kegiatan sosial (true/false): ");
        boolean kegiatanSosial = beasiswa.nextBoolean();

        if ((ipk >= 3.50) && (penghasilan < 3000000) && (Beasiswa == false)) {
            System.out.println("Prioritas utama");
        } else if ((ipk > 3.00) && (penghasilan < 5000000) && (tanggungan >= 3) && (Beasiswa == false)) {
            System.out.println("Prioritas kedua");
        } else if ((ipk >= 3.00) && (Beasiswa == false) && (kegiatanSosial == true)) {
            System.out.println("Pertimbangan khusus");
        } else {
            System.out.println("Belum memenuhi prioritas");
        }

        beasiswa.close();
    }
}