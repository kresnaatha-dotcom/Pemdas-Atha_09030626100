public class Materi_array {
    public static void main(String[] args) {
        int[] nilai = {80,75,90,85,70};
        int jumlahlulus = 0;

        for(int i = 0; i < nilai.length; i++) {
            if (nilai[i] >= 75) {
                jumlahlulus++;
            }
        }

        System.out.println("Jumlah mahasiswa lulus = " + jumlahlulus);
    }
}