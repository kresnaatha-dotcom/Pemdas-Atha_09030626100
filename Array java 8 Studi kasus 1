public class Materi_array {

    public static void main(String[] args) {
        int[] nilai = {25, 30, 18, 40, 35, 45, 50};
        int total = 0;
        int hari = 0;

        for (int i = 0; i < nilai.length; i++) {
            if (nilai[i] <= 30) {
                hari++;
            }
        }

        int max = nilai[0];
        int min = nilai[0];

        for (int i = 0; i < nilai.length; i++) {
            total += nilai[i];
            if (nilai[i] > max) max = nilai[i];
            if (nilai[i] < min) min = nilai[i];
        }

        double rataRata = (double) total / nilai.length;

        System.out.println("\n=== HASIL ===");
        System.out.println("Total = " + total);
        System.out.println("Rata-rata = " + rataRata);
        System.out.println("Penjualan tertinggi = " + max);
        System.out.println("Penjualan terendah = " + min);
        System.out.println("Jumlah hari min 30 = " + hari);
    }
}