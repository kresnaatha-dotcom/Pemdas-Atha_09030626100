import java.util.Scanner;

//Identitas Diri:
//NIM: 09030626100
//NAMA: Kresna Atha Cahyagama Ahmad
//Modul Praktikum Bab 1

public class KebutuhanAirWudlu {

    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        System.out.println("Jumlah mahasiswa : ");
        int jumlahMahasiswa = input.nextInt();

        System.out.println("Frekuensi wudhu: ");
        int frekuensiWudhu = input.nextInt();

        System.out.println("Air per wudhu (liter): ");
        double airPerWudhu = input.nextDouble();

        double totalAir = jumlahMahasiswa * frekuensiWudhu * airPerWudhu;
        double hemat = 0.15;
        double airyangdiHemat = totalAir * hemat;
        double totalAirSetelahHemat = totalAir - airyangdiHemat;

        System.out.println("\n=== HASIL ===");
        System.out.println("Total kebutuhan air = " + totalAir + " liter");
        System.out.println("Air yang dihemat = " + airyangdiHemat + " liter");
        System.out.println("Total kebutuhan air setelah penghematan = " + totalAirSetelahHemat + " liter");

        input.close();
    }
}